{
  "name": "vite-plugin-vue-inspector",
  "version": "6.0.0",
  "description": "Jump to local IDE source code when clicking Vue elements in the browser.",
  "keywords": [
    "debug",
    "devtools",
    "inspector",
    "vite",
    "vite-plugin",
    "vscode",
    "vue"
  ],
  "homepage": "https://github.com/webfansplz/vite-plugin-vue-inspector#readme",
  "bugs": {
    "url": "https://github.com/webfansplz/vite-plugin-vue-inspector/issues"
  },
  "license": "MIT",
  "author": "webfansplz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webfansplz/vite-plugin-vue-inspector.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "src/load.js",
    "src/client"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./client/record": {
      "types": "./dist/client/record.d.mts",
      "import": "./dist/client/record.mjs",
      "default": "./dist/client/record.mjs"
    },
    "./client/listeners": {
      "types": "./dist/client/listeners.d.mts",
      "import": "./dist/client/listeners.mjs",
      "default": "./dist/client/listeners.mjs"
    },
    "./client/overlay": {
      "types": "./dist/client/overlay.d.mts",
      "import": "./dist/client/overlay.mjs",
      "default": "./dist/client/overlay.mjs"
    },
    "./client/vite-devtools": {
      "types": "./dist/client/vite-devtools.d.mts",
      "import": "./dist/client/vite-devtools.mjs",
      "default": "./dist/client/vite-devtools.mjs"
    },
    "./src/*": "./src/*"
  },
  "scripts": {
    "dev": "pnpm -w dev",
    "build": "pnpm -w build",
    "prepublishOnly": "pnpm -w build"
  },
  "dependencies": {
    "@vue/compiler-dom": "catalog:",
    "estree-walker": "catalog:",
    "kolorist": "catalog:",
    "magic-string": "catalog:",
    "nanoevents": "catalog:",
    "source-map-js": "catalog:"
  },
  "devDependencies": {
    "@vitejs/devtools-kit": "catalog:dev"
  },
  "peerDependencies": {
    "@vitejs/devtools-kit": "^0.3.1",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0-0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@vitejs/devtools-kit": {
      "optional": true
    }
  }
}
